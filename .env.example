# Postgres connection used by both pipelines (psycopg DSN, not a SQLAlchemy URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cra_dev

# Embedding model, loaded in-process (sentence-transformers) on each embedding
# run rather than served from a long-running model server.
EMBED_MODEL_HF_ID=nomic-ai/nomic-embed-text-v1
EMBED_DIM=768
EMBED_MAX_TOKENS=8192

# Anthropic direct API — used for structured extraction (table classification
# and prose field extraction).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
